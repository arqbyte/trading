# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379

API_HOST=0.0.0.0
API_PORT=4000

# Live trading is hard-disabled in this build. This flag only exists so the
# setting is explicit; the live execution service is not implemented yet.
LIVE_TRADING_ENABLED=false

# Market data collector (apps/workers/market-data)
MARKET_DATA_TIMEFRAMES=1m,5m,15m,1h,4h,1d
MARKET_DATA_BACKFILL_CANDLES=500
MARKET_DATA_STALE_AFTER_MS=15000
MARKET_DATA_ORDERBOOK_SNAPSHOT_MS=5000
MARKET_DATA_GAP_SWEEP_MS=300000
